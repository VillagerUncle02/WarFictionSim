{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WarFictionSim command",
  "description": "Runtime schema for player and AI commands (T014). Mirrors specs/001-war-sim-command-battle/contracts/command-schema.md section 1; semantic checks beyond structure live in command_validation.cpp.",
  "schema_version": 1,
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "target",
    "completion",
    "intent",
    "behavior",
    "priority",
    "deadline"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "unit",
            "zone",
            "point",
            "units"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "批量命令（kind=units）的目标单位集合（T029，FR-045）"
        }
      }
    },
    "completion": {
      "type": "object",
      "required": [
        "condition"
      ],
      "properties": {
        "condition": {
          "type": "string",
          "minLength": 1,
          "description": "完成条件：secure_zone/destroy_unit/drive_out/clear/hold/reach_point/patrol/fortify/recon（语义参数校验见 command_validation.cpp，M1）"
        },
        "params": {
          "type": "object"
        }
      }
    },
    "intent": {
      "type": "string"
    },
    "behavior": {
      "type": "object",
      "properties": {
        "engagement": {
          "enum": [
            "aggressive",
            "balanced",
            "cautious"
          ]
        },
        "ammo_override": {
          "type": "string",
          "minLength": 1
        },
        "formation": {
          "enum": [
            "march",
            "combat"
          ],
          "description": "队形手动覆盖（T030，FR-060）"
        },
        "failure_action": {
          "enum": [
            "withdraw_to",
            "hold",
            "report"
          ]
        }
      }
    },
    "priority": {
      "type": "integer",
      "minimum": 0
    },
    "deadline": {
      "type": "object",
      "required": [
        "game_time"
      ],
      "properties": {
        "game_time": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "withdraw_command_id": {
      "type": "string",
      "minLength": 1,
      "description": "撤回命令指向的在途命令 id（T029，FR-045）"
    },
    "replace_with": {
      "type": "object",
      "description": "修改命令携带的完整替代命令（T029，FR-045）"
    }
  },
  "additionalProperties": true
}
