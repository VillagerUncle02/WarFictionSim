{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WarFictionSim terrain catalog",
  "description": "Runtime schema for data/terrain/terrain.json (T037). Mirrors specs data-model.md section 10 and FR-022 unified passability rules.",
  "schema_version": 1,
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "const": "terrain"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "terrain_class",
          "type",
          "passability",
          "concealment",
          "cover"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "terrain_class": {
            "enum": [
              "base",
              "surface_cover",
              "artificial",
              "environment"
            ]
          },
          "type": {
            "enum": [
              "plain",
              "forest",
              "grass",
              "river",
              "lake",
              "swamp",
              "building",
              "road",
              "bridge",
              "fortification"
            ]
          },
          "passability": {
            "type": "object",
            "required": [
              "speed_multiplier",
              "blocked",
              "is_water",
              "requires_bridge",
              "amphibious_allowed"
            ],
            "properties": {
              "speed_multiplier": {
                "type": "number",
                "minimum": 0
              },
              "blocked": {
                "type": "boolean"
              },
              "is_water": {
                "type": "boolean"
              },
              "requires_bridge": {
                "type": "boolean"
              },
              "amphibious_allowed": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "concealment": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "cover": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
