<!-- 文件总览：支援请求视图（T053）。
     目标单位（己方可指挥单位下拉）、需求类型（五种枚举单选）、支援种类
     多选（来自所属编制资源池）、数量、分数显示与扣减反馈（剩余/预计/扣减后，
     不足时红色提示）、请求状态与结果提示；三级校验提示按严重级着色内嵌。
     全键盘可操作：访问键 + Tab 顺序 + AutomationProperties（沿命令面板风格）。 -->
<UserControl x:Class="WarFictionSim.Ui.SupportPanel.SupportPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="360"
             KeyboardNavigation.TabNavigation="Cycle">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock Text="{Binding SupportModeHint}" TextWrapping="Wrap" Foreground="#888888"
                       FontSize="11" Margin="0,0,0,8"/>

            <GroupBox Header="目标单位（己方可指挥单位）(_T)">
                <ComboBox ItemsSource="{Binding TargetUnits}" DisplayMemberPath="Id" SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedTargetUnitId}"
                          AutomationProperties.Name="支援请求目标单位"/>
            </GroupBox>

            <GroupBox Header="需求类型（单选）(_Y)" Margin="0,10,0,0">
                <ComboBox ItemsSource="{Binding RequestTypes}" DisplayMemberPath="DisplayName" SelectedValuePath="Key"
                          SelectedValue="{Binding SelectedRequestType}"
                          AutomationProperties.Name="支援需求类型"/>
            </GroupBox>

            <GroupBox Header="支援种类（来自所属编制资源池，可多选）(_K)" Margin="0,10,0,0">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding KindOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}"
                                          Margin="0,2" AutomationProperties.Name="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="只能请求上级组织编制资源池内的力量（FR-008）"
                               Foreground="#888888" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="数量与分数(_Q)" Margin="0,10,0,0">
                <StackPanel>
                    <DockPanel Margin="0,2">
                        <TextBlock DockPanel.Dock="Left" Text="数量（每种）" VerticalAlignment="Center" Width="88"/>
                        <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="支援数量"/>
                    </DockPanel>
                    <TextBlock Text="{Binding ScoreRemainingText}" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding EstimatedCostText}" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding ScoreAfterText}" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScoreInsufficient}" Value="True">
                                        <Setter Property="Foreground" Value="#B3261E"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="请求参数" Margin="0,10,0,0">
                <StackPanel>
                    <DockPanel Margin="0,2">
                        <TextBlock DockPanel.Dock="Left" Text="受理上级节点" VerticalAlignment="Center" Width="88"/>
                        <TextBox Text="{Binding ToNodeText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="受理上级节点"/>
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="关联任务命令" VerticalAlignment="Center" Width="88"/>
                        <TextBox Text="{Binding ForCommandIdText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="关联任务命令"/>
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="优先级" VerticalAlignment="Center" Width="88"/>
                        <TextBox Text="{Binding PriorityText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="支援请求优先级"/>
                        <TextBlock DockPanel.Dock="Right" Text="时限(tick)" VerticalAlignment="Center"/>
                        <TextBox Width="100" Text="{Binding DeadlineTickText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="6,0,0,0" AutomationProperties.Name="支援请求时限"/>
                    </DockPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="请求状态与结果(_S)" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding PendingText}"/>
                    <TextBlock Text="{Binding AttachText}" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#EEEEEE"/>
                </StackPanel>
            </GroupBox>

            <Button Content="提交支援请求(_B)" Command="{Binding SubmitCommand}" Margin="0,12,0,0" Padding="8,6"
                    AutomationProperties.Name="提交支援请求"/>

            <ItemsControl ItemsSource="{Binding Issues}" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock TextWrapping="Wrap" Margin="0,2" Text="{Binding Message}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#888888"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                                            <Setter Property="Foreground" Value="#B3261E"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                            <Setter Property="Foreground" Value="#8A6D00"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
