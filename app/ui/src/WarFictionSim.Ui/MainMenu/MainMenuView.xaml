<!-- 文件总览：主菜单视图（T039）。
     承载作战规模选择、场景/扮演节点选择、教程/新游戏/读档入口；
     全部交互走 ViewModel 命令，内联错误文本来自 ErrorMessage。
     全键盘可操作：AccessText 访问键 + 默认 Tab 导航顺序。 -->
<UserControl x:Class="WarFictionSim.Ui.MainMenu.MainMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:menu="clr-namespace:WarFictionSim.Ui.MainMenu"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="760"
             KeyboardNavigation.TabNavigation="Cycle"
             Focusable="False">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Column="0" Header="选择作战规模与场景" Margin="0,0,12,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,12">
                    <RadioButton Content="连排级"
                                 IsChecked="{Binding SelectedScale, Converter={x:Static menu:CombatScaleToBooleanConverter.Platoon}}"
                                 AutomationProperties.Name="作战规模：连排级"/>
                    <RadioButton Content="营级" Margin="12,0,0,0"
                                 IsChecked="{Binding SelectedScale, Converter={x:Static menu:CombatScaleToBooleanConverter.Battalion}}"
                                 AutomationProperties.Name="作战规模：营级"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding VisibleScenarios}"
                         SelectedItem="{Binding SelectedScenario}"
                         DisplayMemberPath="Name"
                         AutomationProperties.Name="场景列表"
                         KeyboardNavigation.TabNavigation="Cycle"/>
            </DockPanel>
        </GroupBox>

        <StackPanel Grid.Column="1">
            <GroupBox Header="扮演节点">
                <StackPanel>
                    <ComboBox ItemsSource="{Binding AvailableNodes}"
                              SelectedItem="{Binding SelectedNodeId}"
                              IsEnabled="{Binding CanChooseNode}"
                              AutomationProperties.Name="扮演节点"/>
                    <TextBlock Text="{Binding PlayerNodeNote}" Foreground="#8A6D00"
                               TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="并行度（只影响性能）" Margin="0,12,0,0">
                <ComboBox SelectedValuePath="Content"
                          SelectedValue="{Binding Threads}"
                          AutomationProperties.Name="并行度">
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="4"/>
                    <ComboBoxItem Content="8"/>
                </ComboBox>
            </GroupBox>

            <Button Content="新游戏(_N)" Command="{Binding StartNewGameCommand}" Margin="0,16,0,0" Padding="8,6"
                    AutomationProperties.Name="开始新游戏"/>
            <Button Content="教程(_T)" Command="{Binding StartTutorialCommand}" Margin="0,8,0,0" Padding="8,6"
                    AutomationProperties.Name="进入教程"/>
            <Button x:Name="LoadSaveButton" Content="读档(_L)…" Click="LoadSaveButton_Click" Margin="0,8,0,0" Padding="8,6"
                    AutomationProperties.Name="读取存档"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#B3261E"
                       TextWrapping="Wrap" Margin="0,16,0,0"
                       Visibility="{Binding HasError, Converter={x:Static menu:BooleanToVisibilityConverterEx.Default}}"/>
            <TextBlock Text="{Binding LoadIssuesText}" Foreground="#8A6D00"
                       TextWrapping="Wrap" Margin="0,8,0,0" MaxHeight="90"/>
        </StackPanel>
    </Grid>
</UserControl>
