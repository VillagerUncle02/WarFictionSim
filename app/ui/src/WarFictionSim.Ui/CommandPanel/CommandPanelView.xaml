<!-- 文件总览：命令面板视图（T041）。
     承载类型/执行单位/完成条件/优先级/时限输入，三级校验提示按严重级
     着色内嵌显示（错误=红、警告=黄、建议=灰），提交按钮仅在无错误时可用。
     全键盘可操作：访问键 + Tab 顺序 + 焦点可见样式（FocusVisualStyle）。 -->
<UserControl x:Class="WarFictionSim.Ui.CommandPanel.CommandPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cmd="clr-namespace:WarFictionSim.Ui.CommandPanel"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="360"
             KeyboardNavigation.TabNavigation="Cycle">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <GroupBox Header="命令类型(_Y)">
                <ComboBox x:Name="TypeComboBox" ItemsSource="{Binding CommandTypes}"
                          DisplayMemberPath="DisplayName" SelectedValuePath="Key"
                          SelectionChanged="TypeComboBox_SelectionChanged"
                          AutomationProperties.Name="命令类型"/>
            </GroupBox>

            <GroupBox Header="执行单位（地图点选/框选）" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="在地图上点选/框选己方单位（Esc 清除全部）"
                               Foreground="#888888" FontSize="11" Margin="0,0,0,4"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="清空(_C)" Click="ClearExecutorsButton_Click" Padding="6,2"
                                AutomationProperties.Name="清空执行单位"/>
                        <ListBox ItemsSource="{Binding Draft.ExecutorIds}" MinHeight="54"
                                 AutomationProperties.Name="已选执行单位"/>
                    </DockPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="完成条件参数" Margin="0,10,0,0">
                <StackPanel>
                    <DockPanel Margin="0,2">
                        <TextBlock DockPanel.Dock="Left" Text="区域目标" VerticalAlignment="Center" Width="76"/>
                        <ComboBox ItemsSource="{Binding ContextZones}"
                                  SelectedItem="{Binding Draft.ZoneId}"
                                  AutomationProperties.Name="区域目标"/>
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="单位目标" VerticalAlignment="Center" Width="76"/>
                        <ComboBox ItemsSource="{Binding ContextUnits}"
                                  DisplayMemberPath="Id" SelectedValuePath="Id"
                                  SelectedValue="{Binding Draft.TargetUnitId}"
                                  AutomationProperties.Name="单位目标"/>
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="目标点 X/Y" VerticalAlignment="Center" Width="76"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="68" Text="{Binding Draft.PointX}" Margin="0,0,4,0"
                                     AutomationProperties.Name="目标点横坐标"/>
                            <TextBox Width="68" Text="{Binding Draft.PointY}"
                                     AutomationProperties.Name="目标点纵坐标"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="驻留/巡逻/构筑(tick)" VerticalAlignment="Center" Width="76"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="64" Text="{Binding Draft.DurationTicks}" Margin="0,0,4,0"
                                     AutomationProperties.Name="驻留时长"/>
                            <TextBox Width="64" Text="{Binding Draft.CycleTicks}" Margin="0,0,4,0"
                                     AutomationProperties.Name="巡逻周期"/>
                            <TextBox Width="64" Text="{Binding Draft.ConstructionTicks}"
                                     AutomationProperties.Name="构筑时长"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="行为与意图" Margin="0,10,0,0">
                <StackPanel>
                    <DockPanel Margin="0,2">
                        <TextBlock DockPanel.Dock="Left" Text="接敌策略" VerticalAlignment="Center" Width="76"/>
                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Draft.Engagement}"
                                  AutomationProperties.Name="接敌策略">
                            <ComboBoxItem Content="交火" Tag="aggressive"/>
                            <ComboBoxItem Content="伺机" Tag="balanced"/>
                            <ComboBoxItem Content="规避" Tag="cautious"/>
                        </ComboBox>
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="失败后处置" VerticalAlignment="Center" Width="76"/>
                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Draft.FailureAction}"
                                  AutomationProperties.Name="失败后处置">
                            <ComboBoxItem Content="撤退至指定区域" Tag="withdraw_to"/>
                            <ComboBoxItem Content="坚守" Tag="hold"/>
                            <ComboBoxItem Content="上报" Tag="report"/>
                        </ComboBox>
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="弹药覆盖" VerticalAlignment="Center" Width="76"/>
                        <TextBox Text="{Binding Draft.AmmoOverride}"
                                 AutomationProperties.Name="弹药覆盖"/>
                    </DockPanel>
                    <TextBlock Text="意图/附加说明" Margin="0,6,0,2"/>
                    <TextBox Text="{Binding Draft.Intent}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48"
                             AutomationProperties.Name="意图说明"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="优先级与时限" Margin="0,10,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="优先级" VerticalAlignment="Center" Width="76"/>
                    <TextBox Text="{Binding Draft.Priority}" AutomationProperties.Name="优先级"/>
                    <TextBlock DockPanel.Dock="Right" Text="时限(tick)" VerticalAlignment="Center"/>
                    <TextBox Width="100" Text="{Binding Draft.DeadlineTick}" Margin="6,0,0,0"
                             AutomationProperties.Name="时限"/>
                </DockPanel>
            </GroupBox>

            <Button Content="下达命令(_S)" Command="{Binding SubmitCommand}" Margin="0,12,0,0" Padding="8,6"
                    AutomationProperties.Name="下达命令"/>

            <ItemsControl ItemsSource="{Binding Issues}" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock TextWrapping="Wrap" Margin="0,2" Text="{Binding Message}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#888888"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                                            <Setter Property="Foreground" Value="#B3261E"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                            <Setter Property="Foreground" Value="#8A6D00"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
